{
  "name": "racionika",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "server",
    "packages/shared"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n app,server \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev -w @racionika/app",
    "dev:server": "npm run build -w @racionika/shared && npm run dev -w @racionika/server",
    "build": "npm run build -w @racionika/shared && npm run build -w @racionika/app && npm run build -w @racionika/server",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run && node --test scripts/android-config.test.mjs scripts/android-signing.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:android": "npm run dev:android -w @racionika/app",
    "apk:debug": "npm run apk:debug -w @racionika/app",
    "doctor": "node scripts/doctor.mjs",
    "postinstall": "node scripts/restore-android.mjs",
    "test:e2e:local": "playwright test --config=playwright.local.config.ts",
    "dev:demo": "node scripts/start-demo.mjs",
    "test:e2e:built": "playwright test --config=playwright.built.config.ts",
    "build:server": "npm run build -w @racionika/shared && npm run build -w @racionika/server",
    "apk:release": "npm run apk:release -w @racionika/app"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
