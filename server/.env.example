# Скопировать в server/.env. НЕ публиковать файл с ключами.
PORT=8787
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
JWT_SECRET=
# Создайте JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_ACCESS_CODE=
MODEL_FAST=claude-haiku-5-5
MODEL_ACCURATE=claude-sonnet-5-5
MIN_APP_VERSION=0.2.0
MOCK_AI=false
MAINTENANCE_MODE=false
DAILY_ANALYSIS_LIMIT=40
DAILY_LOOKUP_LIMIT=30
DAILY_CHAT_LIMIT=150
GLOBAL_DAILY_REQUEST_CAP=300
IP_DAILY_REQUEST_CAP=150
# 0 — не доверять forwarded IP. Менять только под известную топологию прокси.
TRUST_PROXY_HOPS=0
# Альтернативы требуют MODEL_FAST/MODEL_ACCURATE с доступными вашему аккаунту моделями:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Необязательные текущие цены fast-модели (иначе стоимость возвращается null):
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=
