# Скопировать в server/.env. Файл с настоящими секретами НЕ публиковать.
PORT=8787
AI_PROVIDER=anymodel
ANYMODEL_API_KEY=
JWT_SECRET=
# Генератор JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
REQUIRE_ACCESS_CODE=false
# Только для отдельного закрытого развёртывания, если REQUIRE_ACCESS_CODE=true
APP_ACCESS_CODE=
# Обе модели: точный ID vision/imageToText из AnyModel, включая префикс.
# Можно начать с одной модели, указав один и тот же ID в обеих строках.
MODEL_FAST=
MODEL_ACCURATE=
MIN_APP_VERSION=0.2.0
MOCK_AI=false
MAINTENANCE_MODE=false
# true для одного сайта+API на Render, false при разработке через Vite.
SERVE_WEB=false
DAILY_ANALYSIS_LIMIT=40
DAILY_LOOKUP_LIMIT=30
DAILY_CHAT_LIMIT=150
GLOBAL_DAILY_REQUEST_CAP=300
IP_DAILY_REQUEST_CAP=150
TRUST_PROXY_HOPS=0
# Прямые провайдеры по-прежнему доступны через соответствующий AI_PROVIDER:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Опциональные USD-цены только прямой fast-модели. Для AnyModel USD не вычисляется:
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=
